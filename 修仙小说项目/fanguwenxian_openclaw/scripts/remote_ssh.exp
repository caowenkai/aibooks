#!/usr/bin/expect -f
set timeout 120

if {$argc < 3} {
  puts stderr "usage: remote_ssh.exp <host> <password> <command>"
  exit 2
}

set host [lindex $argv 0]
set password [lindex $argv 1]
set remote_cmd [lindex $argv 2]

log_user 1
spawn ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@$host $remote_cmd

expect {
  -re ".*yes/no.*" {
    send "yes\r"
    exp_continue
  }
  -re ".*assword:.*" {
    send "$password\r"
    exp_continue
  }
  eof
}
